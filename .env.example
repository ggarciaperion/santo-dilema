# Cloudinary Configuration (para almacenamiento de comprobantes)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Upstash Redis (base de datos)
KV_REST_API_URL=your_upstash_url
KV_REST_API_TOKEN=your_upstash_token

# PIN para panel de delivery (por defecto: 1234)
# IMPORTANTE: usar DELIVERY_PIN (sin NEXT_PUBLIC_) — el PIN se valida server-side
# y nunca viaja al cliente. Actualizar también en Vercel Dashboard → Environment Variables.
DELIVERY_PIN=1234

# ─── SEGURIDAD ADMIN (OBLIGATORIO EN PRODUCCIÓN) ───────────────────────────
# Contraseña del panel admin. DEBE configurarse en Vercel → Environment Variables.
# En producción, si no está configurada, el login queda bloqueado intencionalmente.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR_ESTE_VALOR_EN_PRODUCCION

# Secret para endpoints de mantenimiento (fix-redis).
# Puede ser el mismo que ADMIN_PASSWORD.
ADMIN_SECRET=CAMBIAR_ESTE_VALOR_EN_PRODUCCION
